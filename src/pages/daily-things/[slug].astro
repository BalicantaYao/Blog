---
import { type CollectionEntry, getCollection } from 'astro:content';
import DailyThingsEntry from '../../layouts/DailyThingsEntry.astro';
import { withBase } from '../../consts';

export async function getStaticPaths() {
	const entries = (await getCollection('dailyThings')).sort((a, b) =>
		a.data.date < b.data.date ? -1 : a.data.date > b.data.date ? 1 : 0,
	);

	return entries.map((entry, index) => ({
		params: { slug: entry.data.date },
		props: {
			entry,
			prev: index > 0 ? entries[index - 1] : undefined,
			next: index < entries.length - 1 ? entries[index + 1] : undefined,
		},
	}));
}

type Entry = CollectionEntry<'dailyThings'>;

interface Props {
	entry: Entry;
	prev?: Entry;
	next?: Entry;
}

const { entry, prev, next } = Astro.props;

function neighbor(item?: Entry) {
	if (!item) return undefined;
	return { href: withBase(`/daily-things/${item.data.date}/`) };
}
---

<DailyThingsEntry
	date={entry.data.date}
	items={entry.data.items}
	prev={neighbor(prev)}
	next={neighbor(next)}
/>
