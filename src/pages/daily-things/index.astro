---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { withBase } from '../../consts';

const entries = (await getCollection('dailyThings')).sort((a, b) =>
	a.data.date < b.data.date ? 1 : a.data.date > b.data.date ? -1 : 0,
);

const description = entries[0]
	? `${entries[0].data.date} ${entries[0].data.items[0].title}`
	: '每天幾件小事。';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title="Daily Things" description={description} />
		<style>
			h1 {
				font-size: 1.6rem;
				margin-bottom: 1.25rem;
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			li {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 0.75rem 0;
			}
			li:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			a.row {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				text-decoration: none;
				color: rgb(var(--black));
			}
			a.row:hover .summary {
				color: rgb(var(--accent));
			}
			.date {
				flex-shrink: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				font-variant-numeric: tabular-nums;
			}
			.summary {
				font-weight: 600;
			}
			.empty {
				color: rgb(var(--gray));
				margin: 0;
			}
			@media (max-width: 480px) {
				a.row {
					flex-direction: column;
					gap: 0.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Daily Things</h1>
			{
				entries.length === 0 ? (
					<p class="empty">還沒有紀錄。</p>
				) : (
					<ul>
						{entries.map((entry) => (
							<li>
								<a class="row" href={withBase(`/daily-things/${entry.data.date}/`)}>
									<time class="date" datetime={entry.data.date}>
										{entry.data.date}
									</time>
									<span class="summary">{entry.data.items[0].title}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
