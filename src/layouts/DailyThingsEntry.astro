---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Item {
	title: string;
	body: string;
}

interface Neighbor {
	href: string;
}

interface Props {
	date: string;
	items: Item[];
	prev?: Neighbor;
	next?: Neighbor;
}

const { date, items, prev, next } = Astro.props;
const lead = items[0];
const description = lead ? `${lead.title}：${lead.body}` : 'Daily Things';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`Daily Things · ${date}`} description={description} />
		<style>
			.day-header h1 {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				margin: 0 0 1.25rem;
				font-size: 1rem;
				font-weight: 400;
				line-height: 1.2;
			}
			.day-header time {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				font-variant-numeric: tabular-nums;
				letter-spacing: 0.02em;
			}
			.day-header .name {
				color: rgb(var(--black));
				font-size: 1.75rem;
				font-weight: 700;
				line-height: 1.2;
			}
			.entries {
				margin: 1.5rem 0 0;
				padding-left: 1.4rem;
			}
			.entries li {
				margin: 0 0 1.15rem;
				padding-left: 0.35rem;
			}
			.entries li:last-child {
				margin-bottom: 0;
			}
			.day-nav {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin-top: 2.5rem;
				padding-top: 1rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.95rem;
			}
			.day-nav a {
				text-decoration: none;
			}
			.day-nav .next {
				margin-left: auto;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="day-header">
					<h1>
						<time datetime={date}>{date}</time>
						<span class="name">Daily Things</span>
					</h1>
					<hr />
				</header>
				<ol class="entries">
					{
						items.map((item) => (
							<li><strong>{item.title}</strong>：{item.body}</li>
						))
					}
				</ol>
				{
					(prev || next) && (
						<nav class="day-nav" aria-label="前後日期">
							{prev && (
								<a class="prev" rel="prev" href={prev.href}>
									← 前一天
								</a>
							)}
							{next && (
								<a class="next" rel="next" href={next.href}>
									後一天 →
								</a>
							)}
						</nav>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
